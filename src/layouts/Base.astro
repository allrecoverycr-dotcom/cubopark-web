---
import '../styles/global.css';
import { SITE } from '../data/site';
import { LOTS } from '../data/lots';
import { NAV, href, useT, type Lang, type RouteKey } from '../i18n';

interface Props { lang: Lang; route: RouteKey; title: string; description: string; image?: string; jsonld?: object | object[]; navKey?: RouteKey; home?: boolean }
const { lang, route, title, description, jsonld, navKey, home = false } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const url = new URL(href(route, lang), SITE.domain).href;
const urlEs = new URL(href(route, 'es'), SITE.domain).href;
const urlEn = new URL(href(route, 'en'), SITE.domain).href;
// Imagen para compartir (WhatsApp, Facebook, LinkedIn): logo de Cubo Park en JPG 1200x630
const ogImage = new URL('/og-cubopark.jpg', SITE.domain).href;
const current = navKey || route;
const wa = `https://wa.me/${SITE.contact.whatsapp}`;
const lotsForJs = Object.fromEntries(Object.entries(LOTS).map(([k, v]) => [k, { ...v, url: href(`lot:${k}` as RouteKey, lang) }]));
const org = {
  '@context': 'https://schema.org', '@type': 'RealEstateAgent', name: SITE.name, url: SITE.domain + '/',
  logo: SITE.domain + '/img/logo-color.png', image: SITE.domain + '/img/vista-lateral.webp',
  address: { '@type': 'PostalAddress', streetAddress: SITE.address.street, addressLocality: SITE.address.locality, addressRegion: SITE.address.region, addressCountry: SITE.address.country },
  areaServed: 'Costa Rica',
};
const BUILD = Date.now().toString(36);
const ld = [org, ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---
<!doctype html>
<html lang={lang} data-lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <link rel="alternate" hreflang="es" href={urlEs} />
  <link rel="alternate" hreflang="en" href={urlEn} />
  <link rel="alternate" hreflang="x-default" href={urlEs} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Cubo Park Condominio" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#171515" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class={home ? 'home' : undefined}>
  <a href="#main" class="skip">{t('Saltar al contenido', 'Skip to content')}</a>
  <header class="bar">
    <a class="brand" href={href('home', lang)} aria-label={t('Cubo Park, inicio', 'Cubo Park, home')}>
      <img src="/img/icon-color.png" width="240" height="185" alt="" />
      <img class="wd" src="/img/word-color.png" width="520" height="65" alt="Cubo Park" />
    </a>
    <nav aria-label={t('Principal', 'Main')}>
      {NAV.filter(([k]) => k !== 'home' && k !== 'contact').map(([k, es, en]) => <a href={href(k, lang)} aria-current={k === current ? 'page' : undefined}>{t(es, en)}</a>)}
      <span class="lang" role="group" aria-label="Idioma / Language">
        <a href={urlEs.replace(SITE.domain, '')} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
        <a href={urlEn.replace(SITE.domain, '')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </span>
      <a class="btn act" href={href('contact', lang)}>{t('Agendar visita', 'Book a tour')}</a>
    </nav>
    <span class="end-m"><a class="btn act-m" href={href('contact', lang)}>{t('Agendar visita', 'Book a tour')}</a><button class="menu-btn" aria-expanded="false" aria-controls="mnav">{t('Menú', 'Menu')}</button></span>
  </header>
  <nav class="mnav" id="mnav" aria-label={t('Menú móvil', 'Mobile menu')}>
    {NAV.map(([k, es, en]) => <a href={href(k, lang)}>{t(es, en)}</a>)}
    <a href={(other === 'en' ? urlEn : urlEs).replace(SITE.domain, '')} hreflang={other} lang={other}>{other === 'en' ? 'English' : 'Español'}</a>
    <a class="btn" href={href('contact', lang)}>{t('Agendar visita', 'Book a tour')}</a>
  </nav>

  <main id="main"><slot /></main>

  <footer class="foot">
    <span class="what">{t('Cubo Park, condominio industrial en San Rafael de Alajuela', 'Cubo Park, an industrial condominium in San Rafael, Alajuela')}</span>
    <nav aria-label={t('Pie de página', 'Footer')}>
      {NAV.filter(([k]) => k !== 'home').map(([k, es, en]) => <a href={href(k, lang)}>{t(es, en)}</a>)}
    </nav>
    <span class="end">© <span id="yr">2026</span>. {t('Precios en USD.', 'Prices in USD.')} <a href={(other === 'en' ? urlEn : urlEs).replace(SITE.domain, '')} hreflang={other} lang={other}>{other === 'en' ? 'English' : 'Español'}</a></span>
  </footer>

  <a class="wa" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2s.2-1.1.2-1.2-.2-.2-.4-.3z"/></svg>
  </a>
  <script is:inline define:vars={{ lotsForJs }}>window.CP_LOTS = lotsForJs;</script>
  <script is:inline src={`/assets/app.js?v=${BUILD}`} defer></script>
</body>
</html>
