---
// Master plan interactivo.
// mode="select": la cosa viva — tocar fincas para sumarlas (área y precio) y llevar la selección al formulario.
// mode="focus": resalta una finca (fichas individuales).
import { LOTS, POLY, TAGS, ALL_IDS, SUM_PRICE as SUM } from '../data/lots';
import { useT, href, money, m2, type Lang } from '../i18n';
const { lang, mode = 'select', selected = [], heading = true } = Astro.props as { lang: Lang; mode?: 'select' | 'focus'; selected?: string[]; heading?: boolean };
const t = useT(lang);
const ids = ['ib8', 'ib7', 'ib6', 'ib5', 'ib4'];
const contact = href('contact', lang);
const sub = (k: string) => {
  const v = LOTS[k];
  if (v.kind === 'warehouse') return t('Bodega, precio global', 'Warehouse, package price');
  if (v.kind === 'house') return t('Terreno + casa', 'Land + house');
  return t('Lote del fondo, $250/m²', 'Rear lot, $250/m²');
};
const area = (k: string) => (LOTS[k].kind === 'warehouse' ? LOTS[k].land! : LOTS[k].total!);
---
<div class="planner-plan" data-planner={mode} data-selected={selected.join(',')} data-contact={contact}>
  <div class="plan">
    <div class="swipe-hint" aria-hidden="true">
      <svg viewBox="0 0 48 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6 8 12l6 6M34 6l6 6-6 6M8 12h32"/></svg>
      <span>{t('Deslice para ver todo', 'Swipe to see all')}</span>
    </div>
    <div class="plan-scroll"><div class="plan-inner">
      <img src="/img/masterplan-3d.webp" srcset="/img/masterplan-3d-sm.webp 1200w, /img/masterplan-3d.webp 2400w" sizes="(max-width:980px) 1100px, 96vw" width="2400" height="624"
        alt={t('Master plan de Cubo Park: las fincas FFM-IB-4 a FFM-IB-8 sobre la vista aérea del condominio', 'Cubo Park master plan: lots FFM-IB-4 to FFM-IB-8 over an aerial view of the condominium')} loading="lazy" decoding="async" />
      <svg viewBox="0 0 4000 1040" preserveAspectRatio="none" aria-hidden={mode === 'focus' ? 'true' : undefined}>
        {ids.map((k) => {
          const [tx, ty, lx, l1, l2] = TAGS[k];
          return (<>
            <polygon class={k === 'ib5' ? 'lot rent' : 'lot'} data-id={k} points={POLY[k].map((p) => p.join(',')).join(' ')} tabindex={mode === 'select' ? '-1' : undefined} />
            <g class="tg" data-tag={k}><line x1={lx} y1={l1} x2={lx} y2={l2} /><text x={tx} y={ty} text-anchor="middle">{LOTS[k].code}</text></g>
          </>);
        })}
      </svg>
    </div></div>
  </div>
  {mode === 'select' && (
    <div class="pick">
      <div class="pick-list" role="group" aria-label={t('Fincas disponibles', 'Available lots')}>
        {ALL_IDS.map((k) => (
          <button type="button" class="chip" data-id={k} aria-pressed={selected.includes(k) ? 'true' : 'false'}>
            <b>{LOTS[k].code}</b>
            <span class="pr num">{money(LOTS[k].price)}</span>
            <span>{sub(k)}</span>
            <span class="num" style="text-align:right">{m2(area(k))}</span>
          </button>
        ))}
        <button type="button" class="chip" data-all>
          <b>{t('Todo el proyecto', 'Entire project')}</b>
          <span class="pr num">{money(SUM)}</span>
          <span>{t('Las cinco fincas', 'All five lots')}</span>
        </button>
      </div>
      <div class="sum" aria-live="polite">
        <div class="price num" data-sum-price>$0</div>
        <div class="area num" data-sum-area>{t('Toque una finca en el plano o en la lista', 'Tap a lot on the plan or in the list')}</div>
        <ul data-sum-list></ul>
        <span class="k">{t('Total de su selección, en USD', 'Total of your selection, in USD')}</span>
        <div class="actions">
          <button type="button" class="btn btn-quiet" data-clear>{t('Limpiar', 'Clear')}</button>
          <a class="btn" href={contact} data-sum-go>{t('Consultar', 'Enquire')}</a>
        </div>
      </div>
    </div>
  )}
</div>
