---
import Img from './Img.astro';
import { LOTS } from '../data/lots';
import { useT, href, money, m2, type Lang } from '../i18n';
const { id, lang } = Astro.props as { id: string; lang: Lang };
const t = useT(lang); const v = LOTS[id];
const area = id === 'ib5' ? `${m2(v.built!, 0)} ${t('constr.', 'built')}` : m2(v.total!);
---
<a class="card rv" href={href(`lot:${id}`, lang)}>
  <div class="im"><Img name={v.img} alt={v.code} sizes="(max-width:560px) 100vw, 25vw" /></div>
  <div class="bd"><span class="id">{v.code} · {t(v.status_es, v.status_en)}</span><h3>{t(v.name_es, v.name_en)}</h3>
    <div class="meta"><span>{area}</span><span class="p">{money(v.price)}</span></div></div>
</a>
