---
// Escenario fijo: fotos apiladas que cambian según la sección que se lee ([data-stage="k"]).
const { items } = Astro.props as { items: { k: string; img: string; alt?: string; contain?: boolean }[] };
---
<aside class="stage">
  <div class="stage-in">
    {items.map((it, i) => <img class={[i === 0 ? 'on' : '', i === 0 && !it.contain ? 'drift' : '', it.contain ? 'contain' : ''].filter(Boolean).join(' ') || undefined} data-k={it.k} src={`/img/${it.img}.webp`} srcset={`/img/${it.img}-sm.webp 900w, /img/${it.img}.webp 2000w`} sizes="(max-width:900px) 100vw, 47vw" width="2000" height="1333" alt={i === 0 ? (it.alt || '') : ''} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />)}
    <span class="cap" data-cap hidden></span>
  </div>
</aside>
