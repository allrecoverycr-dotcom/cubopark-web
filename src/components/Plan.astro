---
// Master plan interactivo. Polígonos tomados del PSB oficial del master plan (no se modifican).
// Colores: lotes del fondo (6, 7, 8), terreno con casa (4) y bodega (5), con leyenda.
import { LOTS, POLY, TAGS } from '../data/lots';
import { useT, type Lang } from '../i18n';
const { lang, selected = 'ib7', current } = Astro.props as { lang: Lang; selected?: string; current?: string };
const t = useT(lang);
const ids = ['ib8', 'ib7', 'ib6', 'ib5', 'ib4'];
const cls = (k: string) => (k === 'ib5' ? 'lot rent' : k === 'ib4' ? 'lot house' : 'lot');
const sub = (k: string) => (k === 'ib5' ? t('Bodega', 'Warehouse') : k === 'ib4' ? t('Casa', 'House') : t('Lote', 'Lot'));
---
<div class="plan-wrap">
  <div class="plan" data-plan={selected} data-current={current}>
    <div class="swipe-hint" aria-hidden="true">
      <svg viewBox="0 0 48 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6 8 12l6 6M34 6l6 6-6 6M8 12h32"/></svg>
      <span>{t('Deslice para ver todo', 'Swipe to see all')}</span>
    </div>
    <div class="plan-scroll"><div class="plan-inner">
      <img src="/img/masterplan-3d.webp" srcset="/img/masterplan-3d-sm.webp 1200w, /img/masterplan-3d.webp 2400w" sizes="(max-width:980px) 1100px, 70vw" width="2400" height="624"
        alt={t('Master plan de Cubo Park en vista aérea lateral', 'Cubo Park master plan, oblique aerial view')} loading="lazy" decoding="async" />
      <svg viewBox="0 0 4000 1040" preserveAspectRatio="none" role="group" aria-label={t('Fincas sobre el master plan', 'Lots on the master plan')}>
        {ids.map((k) => {
          const [tx, ty, lx, l1, l2] = TAGS[k];
          return (<>
            <polygon class={cls(k)} data-id={k} points={POLY[k].map((p) => p.join(',')).join(' ')} tabindex="0" role="button" aria-label={`${LOTS[k].code} · ${t(LOTS[k].status_es, LOTS[k].status_en)}`} />
            <g class="tg" data-tag={k}><line x1={lx} y1={l1} x2={lx} y2={l2} /><text x={tx} y={ty} text-anchor="middle">{LOTS[k].code}</text></g>
          </>);
        })}
      </svg>
      <span class="edge l" aria-hidden="true">← {t('Río Bermúdez', 'Bermúdez River')}</span>
      <span class="edge r" aria-hidden="true">{t('Entrada · calle pública', 'Entrance · public street')} →</span>
    </div></div>
  </div>
  <div class="plan-ui">
    <div>
      <ul class="plan-key" aria-label={t('Leyenda', 'Legend')}>
        <li><i class="k-lot"></i>{t('Lotes industriales en venta', 'Industrial lots for sale')}</li>
        <li><i class="k-house"></i>{t('Terreno con casa existente', 'Land with existing house')}</li>
        <li><i class="k-rent"></i>{t('Bodega · venta o alquiler', 'Warehouse · sale or lease')}</li>
      </ul>
      <div class="plan-legend" role="group" aria-label={t('Seleccionar finca', 'Select a lot')}>{['ib4', 'ib5', 'ib6', 'ib7', 'ib8'].map((k) => <button type="button" class={'chip ' + cls(k).replace('lot', '').trim()} data-id={k} aria-pressed="false"><i></i>{LOTS[k].code}<small>{sub(k)}</small></button>)}</div>
      <p class="plan-hint">{t('Toque una finca en el plano o en la lista para ver sus datos y abrir su ficha. La entrada por la calle pública queda a la derecha y el río Bermúdez a la izquierda. Ubicación ilustrativa sobre fotografía aérea; los linderos oficiales son los de cada plano catastrado.', 'Tap a lot on the plan or in the list to see its details and open its page. The entrance from the public street is on the right and the Bermúdez River on the left. Positions are illustrative over an aerial photo; the official boundaries are those of each cadastral survey.')}</p>
    </div>
    <aside class="plan-card" id="plan-card" aria-live="polite"></aside>
  </div>
</div>
