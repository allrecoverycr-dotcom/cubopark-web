---
import Base from '../layouts/Base.astro';
---
<Base lang="es" route="home" title="Página no encontrada | Cubo Park" description="La página que busca no existe.">
  <section class="phero" style="min-height:70vh"><div class="wrap">
    <span class="eyebrow" style="color:var(--sand)">404</span>
    <h1 class="h-xl" style="margin-top:24px">Página <b>no encontrada</b></h1>
    <p class="lead">La página que busca no existe o cambió de dirección. / The page you are looking for does not exist.</p>
    <div class="hero-ctas"><a class="btn btn-red" href="/">Ir al inicio</a><a class="btn btn-ghost" href="/en/">Go to homepage</a></div>
  </div></section>
</Base>
