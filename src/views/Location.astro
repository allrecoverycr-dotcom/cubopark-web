---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Stage from '../components/Stage.astro';
import { SITE } from '../data/site';
import { useT, href, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
// Tiempos de traslado: completar cuando estén confirmados (ej. '5 min').
const acc: [string, string, string][] = [['Radial Lindora', 'Radial Lindora', ''], ['Ruta 27', 'Route 27', ''], ['Lindora y Santa Ana', 'Lindora and Santa Ana', ''], ['El Coyol', 'El Coyol', ''], ['Aeropuerto Juan Santamaría', 'Juan Santamaría Airport', '']];
---
<Base lang={lang} route="location"
  title={t('Ubicación | Cubo Park, San Rafael de Alajuela', 'Location | Cubo Park, San Rafael, Alajuela')}
  description={t('Cubo Park está en Calle Potrerillos, San Rafael de Alajuela, con acceso a Radial Lindora y Ruta 27.', 'Cubo Park is on Calle Potrerillos, San Rafael, Alajuela, with access to Radial Lindora and Route 27.')}>
  <div class="split" data-stage-root>
    <Stage items={[{ k: 'top', img: 'entorno-aereo-2', alt: t('Cubo Park y el corredor industrial alrededor', 'Cubo Park and the industrial corridor around it') }, { k: 'acc', img: 'aerial-panorama' }, { k: 'area', img: 'casa-entorno' }]} />
    <div class="col">
      <section class="page-head" data-stage="top">
        <nav class="crumbs" aria-label={t('Ruta', 'Breadcrumb')}><a href={href('home', lang)}>{t('Inicio', 'Home')}</a><span aria-hidden="true">/</span><span>{t('Ubicación', 'Location')}</span></nav>
        <h1 class="rise">{t('San Rafael de Alajuela', 'San Rafael, Alajuela')}</h1>
        <p class="lead rise" style="--i:1">{t('Calle Potrerillos, en el corredor industrial del oeste, con salida a Radial Lindora y a la Ruta 27.', 'Calle Potrerillos, in the western industrial corridor, with access to Radial Lindora and Route 27.')}</p>
        <div class="acts rise" style="--i:2"><a class="btn" href={SITE.maps} target="_blank" rel="noopener">{t('Abrir en Google Maps', 'Open in Google Maps')} <Arrow /></a><a class="btn btn-quiet" href={SITE.waze} target="_blank" rel="noopener">Waze</a></div>
      </section>
      <section data-stage="acc" aria-labelledby="u-acc">
        <h2 id="u-acc" class="rise">{t('Conexiones', 'Connections')}</h2>
        <dl class="spec rise" style="--i:1">{acc.map(([es, en, min]) => <><dt>{t(es, en)}</dt><dd>{min || <span class="pend">{t('minutos por confirmar', 'minutes to be confirmed')}</span>}</dd></>)}</dl>
      </section>
      <section data-stage="area" aria-labelledby="u-area">
        <h2 id="u-area" class="rise">{t('El entorno', 'The area')}</h2>
        <div class="prose rise" style="--i:1">
          <p>{t('Cubo Park colinda con parques de bodegas, centros de distribución y empresas de servicios. Al norte, la propiedad termina en el río Bermúdez.', 'Cubo Park borders warehouse parks, distribution centres and service companies. To the north, the property ends at the Bermúdez River.')}</p>
          <p>{t('Dirección registral: distrito San Rafael, cantón Alajuela, provincia de Alajuela.', 'Registered address: San Rafael district, Alajuela canton, Alajuela province.')}</p>
        </div>
        <div class="pair-pics rise" style="--i:2"><img src="/img/calle-interna-3-sm.webp" width="900" height="600" alt={t('Frente de los lotes sobre la calle interna', 'Lot frontage on the internal road')} loading="lazy" /><img src="/img/bodega-calle-sm.webp" width="900" height="600" alt={t('Calle interna frente a la bodega', 'Internal road by the warehouse')} loading="lazy" /><img src="/img/entorno-aereo-sm.webp" width="900" height="600" alt={t('Vista aérea de los lotes y su entorno', 'Aerial view of the lots and surroundings')} loading="lazy" /></div>
        <div class="acts rise" style="--i:3"><a class="btn btn-ink" href={href('contact', lang)}>{t('Agendar visita', 'Book a tour')}</a></div>
      </section>
    </div>
  </div>
</Base>
