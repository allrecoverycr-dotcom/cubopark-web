---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Stage from '../components/Stage.astro';
import { SITE } from '../data/site';
import { useT, href, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const opts: [string, string, string][] = [['todo', 'Todo el proyecto (5 fincas)', 'Entire project (5 lots)'], ['varias', 'Varias fincas', 'Several lots'],
  ['bodega-alquiler', 'Bodega FFM-IB-5, alquiler', 'Warehouse FFM-IB-5, lease'], ['bodega', 'Bodega FFM-IB-5, compra', 'Warehouse FFM-IB-5, purchase'],
  ['ib4', 'FFM-IB-4, terreno y casa', 'FFM-IB-4, land and house'], ['ib6', 'FFM-IB-6, lote del fondo', 'FFM-IB-6, rear lot'],
  ['ib7', 'FFM-IB-7, lote del fondo', 'FFM-IB-7, rear lot'], ['ib8', 'FFM-IB-8, lote del fondo', 'FFM-IB-8, rear lot'], ['otro', 'Otro', 'Other']];
---
<Base lang={lang} route="contact"
  title={t('Contacto | Cubo Park Condominio', 'Contact | Cubo Park Condominio')}
  description={t('Solicite información o agende una visita a los lotes industriales y la bodega de Cubo Park en San Rafael de Alajuela.', 'Request information or book a tour of the industrial lots and warehouse at Cubo Park in San Rafael, Alajuela.')}>
  <div class="split" data-stage-root>
    <Stage items={[{ k: 'top', img: 'bodega-fachada', alt: t('Fachada lateral de la bodega', 'Warehouse side façade') }]} />
    <div class="col">
      <section class="page-head" data-stage="top">
        <nav class="crumbs" aria-label={t('Ruta', 'Breadcrumb')}><a href={href('home', lang)}>{t('Inicio', 'Home')}</a><span aria-hidden="true">/</span><span>{t('Contacto', 'Contact')}</span></nav>
        <h1 class="rise">{t('Agende una visita', 'Book a tour')}</h1>
        <p class="lead rise" style="--i:1">{t('Cuéntenos qué finca le interesa y le enviamos los detalles o coordinamos un recorrido.', 'Tell us which lot interests you and we will send the details or set up a tour.')}</p>
      </section>
      <section aria-labelledby="c-form">
        <h2 id="c-form" class="sr-only">{t('Formulario', 'Form')}</h2>
        <form id="lead" class="form" action="/contacto.php" method="post" novalidate>
          <input type="hidden" name="idioma" value={lang} />
          <div class="hp" aria-hidden="true"><label for="f-web">Web</label><input id="f-web" name="web" tabindex="-1" autocomplete="off" /></div>
          <div class="field full"><label for="f-int">{t('Me interesa', 'I am interested in')}</label><select id="f-int" name="interes">{opts.map(([v, es, en]) => <option value={v}>{t(es, en)}</option>)}</select></div>
          <div class="field"><label for="f-name">{t('Nombre completo', 'Full name')}</label><input id="f-name" name="nombre" required autocomplete="name" /></div>
          <div class="field"><label for="f-co">{t('Empresa (opcional)', 'Company (optional)')}</label><input id="f-co" name="empresa" autocomplete="organization" /></div>
          <div class="field"><label for="f-mail">{t('Correo', 'Email')}</label><input id="f-mail" name="correo" type="email" required autocomplete="email" /></div>
          <div class="field"><label for="f-tel">{t('Teléfono o WhatsApp', 'Phone or WhatsApp')}</label><input id="f-tel" name="telefono" type="tel" required autocomplete="tel" /></div>
          <div class="field full"><label for="f-msg">{t('Mensaje (opcional)', 'Message (optional)')}</label><textarea id="f-msg" name="mensaje"></textarea></div>
          <p class="err full" role="alert" hidden>{t('Falta su nombre, un correo válido o un teléfono.', 'Your name, a valid email or a phone number is missing.')}</p>
          <p class="err full send-err" role="alert" hidden>{t('No se pudo enviar. Escríbanos por WhatsApp o intente de nuevo.', 'It could not be sent. Message us on WhatsApp or try again.')}</p>
          <div class="full"><button class="btn" type="submit">{t('Enviar solicitud', 'Send request')} <Arrow /></button></div>
        </form>
        <div id="lead-ok" class="ok" tabindex="-1" hidden><h2 class="h2">{t('Gracias. Le escribimos pronto.', 'Thank you. We will write soon.')}</h2><p>{t('Recibimos su solicitud.', 'We received your request.')}</p></div>
      </section>
      <section aria-labelledby="c-dir">
        <h2 id="c-dir" class="rise">{t('Directo', 'Direct')}</h2>
        <dl class="spec rise" style="--i:1">
          <dt>WhatsApp</dt><dd><span class="pend num">{SITE.contact.phone}</span></dd>
          <dt>{t('Correo', 'Email')}</dt><dd><span class="pend">{SITE.contact.email}</span></dd>
          <dt>{t('Horario de visitas', 'Tour hours')}</dt><dd><span class="pend">{t('por confirmar', 'to be confirmed')}</span></dd>
          <dt>{t('Dirección', 'Address')}</dt><dd>Calle Potrerillos, San Rafael, Alajuela</dd>
        </dl>
        <div class="pair-pics rise" style="--i:2"><img src="/img/bodega-acceso-sm.webp" width="900" height="600" alt={t('Acceso de la bodega', 'Warehouse entrance')} loading="lazy" /><img src="/img/calle-interna-sm.webp" width="900" height="600" alt={t('Calle interna del condominio', 'Internal road of the condominium')} loading="lazy" /><img src="/img/oficina-vidrio-sm.webp" width="900" height="600" alt={t('Oficinas de la bodega', 'Warehouse offices')} loading="lazy" /></div>
      </section>
    </div>
  </div>
</Base>
