---
import Base from '../layouts/Base.astro';
import Phero from '../components/Phero.astro';
import Plan from '../components/Plan.astro';
import LotCard from '../components/LotCard.astro';
import { LOTS, LOT_IDS, ppm } from '../data/lots';
import { useT, href, money, m2, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const w = LOTS.ib5;
---
<Base lang={lang} route="availability" image="vista-lateral"
  title={t('Disponibilidad y precios | Cubo Park', 'Availability & Pricing | Cubo Park')}
  description={t('Master plan interactivo y precios en USD de los lotes industriales FFM-IB-4, 6, 7 y 8 y la bodega FFM-IB-5 de Cubo Park, San Rafael de Alajuela.', 'Interactive master plan and USD pricing for industrial lots FFM-IB-4, 6, 7 and 8 and warehouse FFM-IB-5 at Cubo Park, San Rafael, Alajuela.')}>
  <Phero lang={lang} img="vista-lateral" crumbs={[[t('Disponibilidad', 'Availability')]]}
    h1={t('Disponibilidad <b>y precios</b>', 'Availability <b>& pricing</b>')}
    lead={t('Cuatro fincas filiales en venta y una bodega en venta o alquiler. Todos los precios en dólares estadounidenses.', 'Four lots for sale and one warehouse for sale or lease. All prices in US dollars.')} />

  <section class="sec dark" style="padding-top:clamp(50px,6vw,80px)"><div class="wrap"><Plan lang={lang} selected="ib6" /></div></section>

  <section class="sec light"><div class="wrap">
    <div class="sec-head split"><div><span class="eyebrow">{t('Comparativo', 'Comparison')}</span>
      <h2 class="h-l" style="margin-top:22px" set:html={t('Todas las fincas, <b>lado a lado</b>', 'Every lot, <b>side by side</b>')} /></div>
      <p class="lead">{t('Los lotes industriales se cotizan a $250 por m² sobre el área total, que incluye la zona verde A.C.L.R. asignada a cada finca.', 'Industrial lots are priced at $250 per m² on total area, which includes the A.C.L.R. green zone assigned to each lot.')}</p></div>
    <div class="filters" data-filter-group="#av-body">
      <button class="f on" data-f="all">{t('Todas', 'All')}</button><button class="f" data-f="sale">{t('En venta', 'For sale')}</button><button class="f" data-f="rent">{t('En alquiler', 'For lease')}</button>
    </div>
    <div class="tbl-wrap"><table class="av">
      <thead><tr><th>{t('Finca', 'Lot')}</th><th>{t('Tipo', 'Type')}</th><th class="r">{t('Área finca', 'Lot area')}</th><th class="r">{t('Zona verde', 'Green zone')}</th><th class="r">{t('Área total', 'Total area')}</th><th class="r">{t('Precio', 'Price')}</th><th class="r">$/m²</th><th>{t('Modalidad', 'Terms')}</th><th><span class="sr-only">{t('Ficha', 'Details')}</span></th></tr></thead>
      <tbody id="av-body">
        {['ib4', 'ib5', 'ib6', 'ib7', 'ib8'].map((k) => {
          const v = LOTS[k];
          return k === 'ib5' ? (
            <tr data-cat="sale rent"><td class="id">{v.code}</td><td>{t('Bodega · 5,500 m² construidos', 'Warehouse · 5,500 m² built')}</td><td class="r">{m2(w.land!, 0)}</td><td class="r">—</td><td class="r">{m2(w.land!, 0)}</td>
              <td class="r pr">{money(v.price)}<br /><span class="muted" style="font-size:.8rem;font-weight:400">{t('o $8/m² + IVA', 'or $8/m² + VAT')}</span></td><td class="r">—</td>
              <td><span class="badge both">{t('Venta / Alquiler', 'Sale / Lease')}</span></td><td><a class="link-arrow" href={href('lot:ib5', lang)}>{t('Ficha', 'Details')}</a></td></tr>
          ) : (
            <tr data-cat="sale"><td class="id">{v.code}</td><td>{t(v.name_es, v.name_en)}</td><td class="r">{m2(v.lot!)}</td><td class="r">{v.green ? m2(v.green) : '—'}</td><td class="r">{m2(v.total!)}</td>
              <td class="r pr">{money(v.price)}</td><td class="r">{money(ppm(v))}</td><td><span class="badge">{t('Venta', 'Sale')}</span></td><td><a class="link-arrow" href={href(`lot:${k}`, lang)}>{t('Ficha', 'Details')}</a></td></tr>
          );
        })}
      </tbody>
    </table></div>
    <p class="muted" style="font-size:.82rem;margin-top:18px">{t('Áreas según planos catastrados y cuadros de áreas del anteproyecto. Precios en USD, sujetos a cambio sin previo aviso.', 'Areas per cadastral surveys and the preliminary project area tables. Prices in USD, subject to change without notice.')}</p>
  </div></section>

  <section class="sec white"><div class="wrap"><div class="cards">{LOT_IDS.map((id) => <LotCard id={id} lang={lang} />)}</div></div></section>
</Base>
