---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Stage from '../components/Stage.astro';
import Planner from '../components/Planner.astro';
import { LOTS, ALL_IDS } from '../data/lots';
import { useT, href, money, m2, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<Base lang={lang} route="project"
  title={t('El Proyecto | Cubo Park Condominio', 'The Project | Cubo Park Condominio')}
  description={t('Condominio industrial de fincas filiales con calle interna, planta de tratamiento, laguna de retención y uso de suelo industrial en San Rafael de Alajuela.', 'Industrial condominium of titled lots with internal road, treatment plant, retention pond and industrial zoning in San Rafael, Alajuela.')}>
  <div class="split" data-stage-root>
    <Stage items={[{ k: 'top', img: 'aerial-panorama', alt: t('Cubo Park y su entorno desde el aire', 'Cubo Park and its surroundings from the air') }, { k: 'how', img: 'bodega-calle' }, { k: 'built', img: 'terreno-aereo-2' }, { k: 'use', img: 'bodega-aerea-2' }]} />
    <div class="col">
      <section class="page-head" data-stage="top">
        <nav class="crumbs" aria-label={t('Ruta', 'Breadcrumb')}><a href={href('home', lang)}>{t('Inicio', 'Home')}</a><span aria-hidden="true">/</span><span>{t('El proyecto', 'The project')}</span></nav>
        <h1 class="rise">{t('Hecho para la industria', 'Built for industry')}</h1>
        <p class="lead rise" style="--i:1">{t('Fincas con título propio y servicios compartidos, en el corredor industrial del oeste.', 'Independently titled lots with shared services, in the western industrial corridor.')}</p>
      </section>
      <section data-stage="how" aria-labelledby="p-how">
        <h2 id="p-how" class="rise">{t('Cómo funciona', 'How it works')}</h2>
        <div class="prose rise" style="--i:1">
          <p>{t('Cubo Park está constituido bajo el régimen de propiedad en condominio, sobre una finca matriz de 67,111.58 m². Cada finca filial tiene plano catastrado y folio real propios, así que se compra, se financia o se vende por separado.', 'Cubo Park is set up under Costa Rica’s condominium property regime, on a 67,111.58 m² parent property. Each lot has its own cadastral survey and title, so it can be bought, financed or sold on its own.')}</p>
          <p>{t('El condominio resuelve en común la calle de acceso, el tratamiento de aguas, la retención pluvial y las zonas verdes. Cada dueño aporta una cuota de mantenimiento.', 'The condominium handles the access road, wastewater treatment, stormwater retention and green areas in common. Each owner contributes a maintenance fee.')}</p>
        </div>
      </section>
      <section data-stage="built" aria-labelledby="p-built">
        <h2 id="p-built" class="rise">{t('Lo que ya está construido', 'What is already built')}</h2>
        <ul class="ticks rise" style="--i:1">
          <li>{t('Calle interna asfaltada con cordón y caño, desde la calle pública hasta el último lote', 'Paved internal road with curbs, from the public street to the last lot')}</li>
          <li>{t('Planta de tratamiento de aguas residuales común', 'Shared wastewater treatment plant')}</li>
          <li>{t('Laguna de retención pluvial impermeabilizada', 'Lined stormwater retention pond')}</li>
          <li>{t('Zonas verdes y franja de protección de 15 m del río Bermúdez', 'Green areas and a 15 m buffer along the Bermúdez River')}</li>
          <li>{t('Caseta de guarda, depósito de basura y cuarto de mantenimiento', 'Guard booth, waste room and maintenance room')}</li>
          <li>{t('Estacionamientos frente a la bodega', 'Parking in front of the warehouse')}</li>
        </ul>
      </section>
      <section data-stage="use" aria-labelledby="p-use">
        <h2 id="p-use" class="rise">{t('Usos permitidos', 'Permitted uses')}</h2>
        <p class="rise" style="--i:1">{t('Según los planos catastrados, las fincas están destinadas a uso industrial, bodegas, ofibodegas y oficinas.', 'Per the cadastral surveys, the lots are designated for industrial use, warehouses, flex space and offices.')}</p>
        <div class="acts rise" style="--i:2"><a class="btn" href={href('availability', lang)}>{t('Ver precios', 'See prices')} <Arrow /></a><a class="btn btn-quiet" href={href('contact', lang)}>{t('Agendar visita', 'Book a tour')}</a></div>
      </section>
    </div>
  </div>

  <section class="planner" aria-labelledby="p-plan">
    <div class="planner-head"><h2 id="p-plan" class="rise">{t('Cinco fincas disponibles', 'Five lots available')}</h2><p class="rise" style="--i:1">{t('Toque las fincas para ver cuánto suman en terreno y en precio. Las fincas FFM-IB-1, 2 y 3 son otras unidades y áreas de paso del condominio.', 'Tap the lots to see what they add up to in land and price. Lots FFM-IB-1, 2 and 3 are other units and rights of way within the condominium.')}</p></div>
    <Planner lang={lang} mode="select" />
  </section>

  <section class="band" aria-labelledby="p-tbl">
    <h2 id="p-tbl" class="h2 rise" style="margin-bottom:28px">{t('Las fincas, según los planos', 'The lots, per the surveys')}</h2>
    <div class="tbl-wrap"><table class="av">
      <thead><tr><th>{t('Finca', 'Lot')}</th><th>{t('Qué es', 'What it is')}</th><th class="r">{t('Área en catastro', 'Cadastral area')}</th><th class="r">{t('Construcción', 'Building')}</th><th class="r">{t('Precio', 'Price')}</th></tr></thead>
      <tbody>{ALL_IDS.map((k) => { const v = LOTS[k]; return (
        <tr><td class="id"><a class="link" href={href(`lot:${k}`, lang)}>{v.code}</a></td>
          <td>{v.kind === 'warehouse' ? t('Bodega con su terreno', 'Warehouse with its land') : t(v.name_es, v.name_en)}</td>
          <td class="r">{m2(v.kind === 'warehouse' ? v.land! : v.lot!)}</td>
          <td class="r">{v.kind === 'warehouse' ? m2(v.built!, 0) : v.kind === 'house' ? t('Casa', 'House') : '—'}</td>
          <td class="r">{money(v.price)}</td></tr>); })}</tbody>
    </table></div>
  </section>
</Base>
