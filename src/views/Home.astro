---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Arrow from '../components/Arrow.astro';
import Planner from '../components/Planner.astro';
import Fields from '../components/Fields.astro';
import { LOTS, ALL_IDS, GAL, CAP, BUNDLE, WAREHOUSE, ppm, landValue, houseValue } from '../data/lots';
import { SITE } from '../data/site';
import { useT, href, money, m2, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const w = LOTS.ib5;
const stageImg: Record<string, string> = { hero: 'aerial-panorama', ib4: 'casa-ib4', ib5: 'bodega-aerea-3', ib6: 'terreno-aereo', ib7: 'terreno-aereo-2', ib8: 'calle-interna-2' };
const lotWhat = (k: string) => {
  const v = LOTS[k];
  if (v.kind === 'house') return t(`Terreno y casa frente a la calle principal`, `Land and house on the main street`);
  if (v.kind === 'warehouse') return t('Bodega de 5,500 m² con su terreno', '5,500 m² warehouse with its land');
  return t(`Lote del fondo, detrás de la bodega`, `Rear lot, behind the warehouse`);
};
const drag: [string, string[]][] = [
  ['tall', ['nave-oficinas']], ['pair', ['bodega-aerea', 'oficina-vidrio']], ['wide', ['nave-panoramica']],
  ['pair', ['pasarela', 'recepcion']], ['tall', ['escalera']], ['wide', ['entorno-aereo']],
  ['pair', ['bodega-fachada', 'oficina-amplia']], ['tall', ['nave-escaleras']], ['wide', ['bodega-calle']],
];
const dragCount = drag.reduce((s, [, a]) => s + a.length, 0);
const commons: [string, string][] = [
  [t('Calle interna de acceso', 'Internal access road'), 'ACC'], [t('Planta de tratamiento', 'Treatment plant'), 'PT'],
  [t('Laguna de retención', 'Retention pond'), 'LR'], [t('Zona de protección del río', 'River buffer zone'), 'ZPR'],
  [t('Zonas verdes', 'Green areas'), 'ZV'], [t('Estacionamientos', 'Parking'), 'EST'],
  [t('Caseta de guarda', 'Guard booth'), 'C'], [t('Cuarto de mantenimiento', 'Maintenance room'), 'M'],
];
---
<Base lang={lang} route="home" home
  title={t('Cubo Park Condominio | Lotes industriales y bodega en Alajuela', 'Cubo Park Condominio | Industrial lots & warehouse in Alajuela, Costa Rica')}
  description={t('Cuatro lotes industriales con título propio y una bodega de 5,500 m² en venta o alquiler en San Rafael de Alajuela, cerca de Lindora y Ruta 27. Precios en USD.', 'Four independently titled industrial lots and a 5,500 m² warehouse for sale or lease in San Rafael, Alajuela, near Lindora and Route 27. Prices in USD.')}>

  <!-- Hero + fincas: el escenario fijo -->
  <div class="hero" data-stage-root>
    <aside class="stage" aria-hidden="true">
      <div class="stage-in">
        {Object.entries(stageImg).map(([k, n], i) => <img class={i === 0 ? 'on drift' : undefined} data-k={k} src={`/img/${n}.webp`} srcset={`/img/${n}-sm.webp 900w, /img/${n}.webp 2000w`} sizes="(max-width:900px) 100vw, 47vw" width="2000" height="1333" alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />)}
        <span class="cap" data-cap hidden></span>
      </div>
    </aside>
    <div class="hero-col">
      <section class="copy" data-stage="hero">
        <h1 class="name" data-scale-name><span>{t('Condominio industrial en San Rafael de Alajuela', 'Industrial condominium in San Rafael, Alajuela')}</span>Cubo Park</h1>
        <div class="lede">
          <p class="rise">{t('Cuatro lotes con título propio y una bodega de 5,500 m², en venta o alquiler.', 'Four independently titled lots and a 5,500 m² warehouse, for sale or lease.')}</p>
          <div class="facts rise" style="--i:1">
            <span><b>{t('5 fincas', '5 lots')}</b> {t('filiales', 'available')}</span>
            <span><b class="num">{m2(BUNDLE.land, 0)}</b> {t('de terreno', 'of land')}</span>
            <span>{t('Desde', 'From')} <b class="num">{money(LOTS.ib8.price)}</b></span>
          </div>
          <div class="acts rise" style="--i:2">
            <a class="btn" href="#fincas">{t('Ver las fincas', 'See the lots')} <Arrow /></a>
            <a class="btn btn-paper" href={href('contact', lang)}>{t('Agendar visita', 'Book a tour')}</a>
          </div>
        </div>
      </section>

      <section class="lots-sec" id="fincas" aria-labelledby="fincas-h">
        <div class="lots-intro">
          <h2 id="fincas-h" class="h2 rise">{t('Cinco fincas, cada una con su título', 'Five lots, each with its own title')}</h2>
          <p class="rise" style="--i:1">{t('Cubo Park está inscrito en régimen de condominio. Cada finca filial tiene plano catastrado y folio real propios: se compra, se financia o se vende por separado.', 'Cubo Park is registered as a condominium. Each lot has its own cadastral survey and title, so it can be bought, financed or sold on its own.')}</p>
        </div>
        <div class="lots">
          {ALL_IDS.map((k) => {
            const v = LOTS[k];
            return (
              <article class="lot-row" id={`f-${k}`} data-stage={k}>
                <img class="mobile-pic" src={`/img/${stageImg[k]}-sm.webp`} width="900" height="600" alt={v.code} loading="lazy" decoding="async" />
                <h3 class="code rise"><a href={href(`lot:${k}`, lang)}>{v.code}</a></h3>
                <p class="what rise" style="--i:1">{lotWhat(k)}</p>
                <dl class="num rise" style="--i:2">
                  {v.kind === 'warehouse' && (<>
                    <dt>{t('Construcción', 'Building')}</dt><dd>{m2(v.built!, 0)}</dd>
                    <dt>{t('Terreno según catastro', 'Land per cadastral survey')}</dt><dd>{m2(v.land!)}</dd>
                    <dt>{t('Alquiler', 'Lease')}</dt><dd>{money(WAREHOUSE.total)} {t('al mes', 'a month')}</dd>
                    <dt class="total">{t('Precio global, terreno y bodega', 'Package price, land and warehouse')}</dt><dd class="total">{money(v.price)}</dd>
                  </>)}
                  {v.kind === 'house' && (<>
                    <dt>{t('Terreno', 'Land')} {m2(v.total!)} × {money(ppm(v))}</dt><dd>{money(landValue(v))}</dd>
                    <dt>{t('Casa construida', 'Existing house')}</dt><dd>{money(houseValue(v))}</dd>
                    <dt class="total">{t('Total terreno y casa', 'Total land and house')}</dt><dd class="total">{money(v.price)}</dd>
                  </>)}
                  {v.kind === 'lot' && (<>
                    <dt>{t('Finca filial', 'Lot')}</dt><dd>{m2(v.lot!)}</dd>
                    <dt>{t(`Zona verde ${v.zv} asignada`, `Assigned green zone ${v.zv}`)}</dt><dd>{m2(v.green!)}</dd>
                    <dt>{t('Área total', 'Total area')} × {money(ppm(v))}/m²</dt><dd>{m2(v.total!)}</dd>
                    <dt class="total">{t('Precio', 'Price')}</dt><dd class="total">{money(v.price)}</dd>
                  </>)}
                </dl>
                <div class="more rise" style="--i:3">
                  <a class="link" href={href(`lot:${k}`, lang)}>{t('Ver la ficha completa', 'See full details')}</a>
                  <a class="link" href="#planner" data-add={k}>{t('Sumar al plano', 'Add to the plan')}</a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </div>
  </div>

  <!-- La cosa viva: arme su compra -->
  <section class="planner" id="planner" aria-labelledby="planner-h">
    <div class="planner-head">
      <h2 id="planner-h" class="rise">{t('Arme su compra', 'Build your purchase')}</h2>
      <p class="rise" style="--i:1">{t('Toque las fincas que le interesan. Sumamos el terreno y el precio de su selección, y se la enviamos al formulario de contacto.', 'Tap the lots you are interested in. We add up the land and the price of your selection, and carry it to the contact form.')}</p>
    </div>
    <Planner lang={lang} mode="select" />
  </section>

  <!-- La bodega: plato cuadrado -->
  <section class="plate" aria-labelledby="bodega-h">
    <div class="plate-pic"><Img name="nave-mezzanine" alt={t('Interior de la bodega: nave libre, mezzanine y oficinas en segundo nivel', 'Warehouse interior: open hall, mezzanine and second-floor offices')} sizes="(max-width:900px) 100vw, 50vw" cls="rise" /></div>
    <div class="plate-txt">
      <div class="tabs" role="tablist" aria-label={t('Bodega FFM-IB-5', 'Warehouse FFM-IB-5')}>
        <button role="tab" id="tb-rent" aria-controls="tp-rent" aria-selected="true">{t('Alquiler', 'Lease')}</button>
        <button role="tab" id="tb-sale" aria-controls="tp-sale" aria-selected="false" tabindex="-1">{t('Venta', 'Sale')}</button>
        <button role="tab" id="tb-spec" aria-controls="tp-spec" aria-selected="false" tabindex="-1">{t('Ficha', 'Specs')}</button>
      </div>
      <div class="plate-body">
        <h2 id="bodega-h" class="rise">{t('Una bodega de 5,500 m² lista para operar', 'A 5,500 m² warehouse ready to operate')}</h2>
        <div role="tabpanel" id="tp-rent" aria-labelledby="tb-rent">
          <div class="fig num">{money(WAREHOUSE.total)}<small>{t('al mes, todo incluido', 'a month, all included')}</small></div>
          <div class="rows num" style="margin-top:24px">
            <div><span>{t('Renta, 5,500 m² × $8', 'Rent, 5,500 m² × $8')}</span><span>{money(WAREHOUSE.rent)}</span></div>
            <div><span>{t('IVA 13%', 'VAT 13%')}</span><span>{money(WAREHOUSE.iva)}</span></div>
            <div><span>{t('Mantenimiento, $1/m²', 'Maintenance, $1/m²')}</span><span>{money(WAREHOUSE.fee)}</span></div>
          </div>
        </div>
        <div role="tabpanel" id="tp-sale" aria-labelledby="tb-sale" hidden>
          <div class="fig num">{money(w.price)}<small>{t('precio global, terreno y bodega', 'package price, land and warehouse')}</small></div>
          <p style="margin-top:24px">{t('Incluye los 4,230.89 m² de terreno de la finca FFM-IB-5 y la bodega de 5,500 m² con sus mezzanines, oficinas y estacionamientos.', 'Includes the 4,230.89 m² of land of lot FFM-IB-5 and the 5,500 m² warehouse with its mezzanines, offices and parking.')}</p>
        </div>
        <div role="tabpanel" id="tp-spec" aria-labelledby="tb-spec" hidden>
          <ul class="ticks">
            <li>{t('Nave de estructura metálica con piso libre', 'Steel-frame hall with an open floor')}</li>
            <li>{t('Mezzanines en dos niveles con pasarelas', 'Two mezzanine levels with walkways')}</li>
            <li>{t('Oficinas con vidrio, recepción y servicios', 'Glass offices, reception and services')}</li>
            <li>{t('Cortinas enrollables y estacionamientos', 'Roll-up doors and parking')}</li>
            <li>{t('Lucernarios y ventilación por celosías', 'Skylights and louvre ventilation')}</li>
            <li>{t('Red y gabinetes contra incendio', 'Fire main and hose cabinets')}</li>
          </ul>
        </div>
      </div>
      <div class="plate-acts">
        <a class="btn btn-ink" href={href('warehouse', lang)}>{t('Ver la bodega', 'See the warehouse')}</a>
        <a class="btn btn-quiet" href={href('contact', lang) + '?interes=bodega'}>{t('Agendar visita', 'Book a tour')}</a>
      </div>
    </div>
  </section>

  <!-- Ya construido: campo rojo -->
  <section class="built" aria-labelledby="built-h">
    <h2 id="built-h">{t('Ya construido', 'Already built')}</h2>
    <div class="built-rows">
      <article class="built-row">
        <h3 class="rise">{t('Calle interna y accesos', 'Internal road and access')}</h3>
        <div class="pair"><Img name="calle-interna" alt={t('Calle interna asfaltada del condominio', 'Paved internal road of the condominium')} sizes="200px" w={2000} h={1333} cls="rise" />
          <ul class="rise" style="--i:1"><li>{t('Calle asfaltada con cordón y caño', 'Paved road with curbs and gutters')}</li><li>{t('Acceso desde la calle pública', 'Access from the public street')}</li><li>{t('Llega hasta el último lote', 'Runs to the last lot')}</li><li>{t('Caseta de guarda en la entrada', 'Guard booth at the entrance')}</li></ul></div>
      </article>
      <article class="built-row">
        <h3 class="rise">{t('Agua tratada y retenida', 'Water treated and retained')}</h3>
        <div class="pair"><Img name="terreno-aereo-2" alt={t('Vista aérea con la laguna de retención al fondo', 'Aerial view with the retention pond at the back')} sizes="200px" cls="rise" />
          <ul class="rise" style="--i:1"><li>{t('Planta de tratamiento común', 'Shared treatment plant')}</li><li>{t('Laguna de retención impermeabilizada', 'Lined retention pond')}</li><li>{t('En el extremo norte del terreno', 'At the north end of the land')}</li><li>{t('Cuarto de mantenimiento', 'Maintenance room')}</li></ul></div>
      </article>
      <article class="built-row">
        <h3 class="rise">{t('Verde y río', 'Green areas and river')}</h3>
        <div class="pair"><Img name="bodega-jardin" alt={t('Zonas verdes frente a la bodega', 'Green areas in front of the warehouse')} sizes="200px" cls="rise" />
          <ul class="rise" style="--i:1"><li>{t('Zonas verdes entre fincas', 'Green areas between lots')}</li><li>{t('Franja de 15 m de protección del río Bermúdez', '15 m buffer along the Bermúdez River')}</li><li>{t('Árboles maduros en la propiedad', 'Mature trees on the property')}</li></ul></div>
      </article>
    </div>
  </section>

  <!-- Dos formas de entrar -->
  <Fields lang={lang} />

  <!-- El condominio, en datos -->
  <section class="facts-sec" aria-labelledby="cond-h">
    <div class="fs-row first">
      <dl class="fs-side">
        <div><dt>{t('Finca matriz', 'Parent property')}</dt><dd class="num">67,111.58 m²</dd></div>
        <div><dt>{t('Régimen', 'Regime')}</dt><dd>{t('Propiedad en condominio', 'Condominium property')}</dd></div>
        <div><dt>{t('Planos', 'Surveys')}</dt><dd>{t('Catastrados, sellados por el CFIA en 2018', 'Registered, sealed by the CFIA in 2018')}</dd></div>
      </dl>
      <div class="fs-main">
        <h2 id="cond-h">{t('El condominio', 'The condominium')}</h2>
        <p class="big">{t('Una franja larga entre la calle Potrerillos y el río Bermúdez, con todo lo común ya construido.', 'A long strip from Calle Potrerillos to the Bermúdez River, with everything shared already built.')}</p>
        <p style="max-width:60ch">{t('La finca con casa da a la calle pública y los tres lotes quedan al fondo, sobre la calle interna. Acceso, tratamiento de aguas, retención pluvial y zonas verdes se administran en común.', 'The lot with the house faces the public street and the three lots lie at the back, along the internal road. Access, wastewater treatment, stormwater retention and green areas are managed in common.')}</p>
      </div>
    </div>
    <div class="fs-row">
      <span class="fs-word">{t('Según los planos', 'Per the surveys')}</span>
      <div class="fs-lists num">
        <div><h3>{t('Fincas filiales', 'Lots')}</h3><ul>{ALL_IDS.map((k) => <li><span>{LOTS[k].code}</span><span>{m2(LOTS[k].kind === 'warehouse' ? LOTS[k].land! : LOTS[k].lot!)}</span></li>)}</ul></div>
        <div><h3>{t('Áreas comunes', 'Common areas')}</h3><ul>{commons.map(([n, c]) => <li><span>{n}</span><span>{c}</span></li>)}</ul></div>
      </div>
    </div>
  </section>

  <!-- La propiedad: fila arrastrable -->
  <section class="drag-sec" aria-labelledby="fotos-h">
    <div class="drag-head"><h2 id="fotos-h">{t('La propiedad', 'The property')}</h2><span><a class="link" href={href('gallery', lang)}>{t(`Ver las ${GAL.length} fotos`, `See all ${GAL.length} photos`)}</a></span></div>
    <div class="drag" data-drag>
      {drag.map(([kind, imgs]) => (
        <div class={`m ${kind}`}>{imgs.map((n) => <button type="button" data-lb="home" data-full={`/img/${n}.webp`} data-cap={t(CAP[n][0], CAP[n][1])} aria-label={t(CAP[n][0], CAP[n][1])}><Img name={n} alt={t(CAP[n][0], CAP[n][1])} sizes="(max-width:900px) 80vw, 40vw" /></button>)}</div>
      ))}
      <div class="end"></div>
    </div>
  </section>

  <!-- Visita -->
  <section class="visit" aria-labelledby="visit-h">
    <Img name="bodega-acceso" alt={t('Acceso y estacionamientos de la bodega', 'Warehouse entrance and parking')} sizes="100vw" />
    <div class="visit-card">
      <h2 id="visit-h">{t('Visite Cubo Park', 'Visit Cubo Park')}</h2>
      <p>Calle Potrerillos, San Rafael<br />Alajuela, Costa Rica</p>
      <div class="rows">
        <div><span>{t('Conexión', 'Access')}</span><span>Radial Lindora, Ruta 27</span></div>
        <div><span>{t('Horario', 'Hours')}</span><span class="pend">{t('por confirmar', 'to be confirmed')}</span></div>
        <div><span>WhatsApp</span><span class="pend num">{SITE.contact.phone}</span></div>
      </div>
      <div class="links"><a class="link" href={SITE.maps} target="_blank" rel="noopener">Google Maps</a><a class="link" href={SITE.waze} target="_blank" rel="noopener">Waze</a></div>
      <a class="btn" href={href('contact', lang)}>{t('Agendar visita', 'Book a tour')}</a>
    </div>
  </section>
</Base>
