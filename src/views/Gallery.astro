---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { GAL } from '../data/lots';
import { useT, href, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const cats: [string, string, string][] = [['all', 'Todas', 'All'], ['aerea', 'Aéreas', 'Aerial'], ['exterior', 'Exterior', 'Exterior'], ['interior', 'Nave', 'Hall'], ['oficinas', 'Oficinas', 'Offices'], ['terreno', 'Terrenos', 'Land']];
---
<Base lang={lang} route="gallery"
  title={t('Galería | Cubo Park Condominio', 'Gallery | Cubo Park Condominio')}
  description={t('Fotografías aéreas e interiores de la bodega y los lotes industriales de Cubo Park en San Rafael de Alajuela.', 'Aerial and interior photos of the warehouse and industrial lots at Cubo Park in San Rafael, Alajuela.')}>
  <section class="band" style="padding-top:calc(var(--bar) + 64px)" aria-labelledby="g-h">
    <div class="gal-head">
      <div class="page-head">
        <nav class="crumbs" aria-label={t('Ruta', 'Breadcrumb')}><a href={href('home', lang)}>{t('Inicio', 'Home')}</a><span aria-hidden="true">/</span><span>{t('Galería', 'Gallery')}</span></nav>
        <h1 id="g-h" class="rise">{t('La propiedad en fotos', 'The property in photos')}</h1>
      </div>
      <div class="filters rise" data-filter-group="#gal" role="group" aria-label={t('Filtrar fotos', 'Filter photos')}>{cats.map(([c, es, en]) => <button type="button" data-f={c} aria-pressed={c === 'all' ? 'true' : 'false'}>{t(es, en)}</button>)}</div>
    </div>
    <div class="mosaic" id="gal">
      {GAL.map(([n, c, es, en]) => <figure data-cat={c}><button type="button" data-lb="gal" data-full={`/img/${n}.webp`} data-cap={t(es, en)} aria-label={t(es, en)}><Img name={n} alt={t(es, en)} sizes="(max-width:700px) 100vw, 33vw" /></button><figcaption>{t(es, en)}</figcaption></figure>)}
    </div>
  </section>
</Base>
